datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  description      String?
  image            String?
  parentCategoryId String?     @map("parent_category_id")
  parentCategory   Category?   @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subcategories    Category[]  @relation("CategoryHierarchy")
  displayOrder     Int         @default(0) @map("display_order")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  products         Product[]

  @@map("categories")
}

model Product {
  id                      String         @id @default(uuid())
  name                    String
  slug                    String         @unique
  brand                   String?
  modelNumber             String?        @map("model_number")
  shortDescription        String?        @map("short_description")
  description             String?
  categoryId              String         @map("category_id")
  category                Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price                   Decimal?
  priceType               String         @default("ENQUIRY_ONLY") @map("price_type")
  currency                String         @default("INR")
  availabilityStatus      String         @default("AVAILABLE") @map("availability_status")
  technicalSpecifications String?        @map("technical_specifications")
  applications            String?
  featured                Boolean        @default(false)
  published               Boolean        @default(true)
  seoTitle                String?        @map("seo_title")
  seoDescription          String?        @map("seo_description")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  media                   ProductMedia[]
  enquiries               Enquiry[]

  @@map("products")
}

model ProductMedia {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaType    String   @default("IMAGE") @map("media_type")
  mediaUrl     String   @map("media_url")
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")

  @@map("product_media")
}

model Enquiry {
  id           String   @id @default(uuid())
  customerName String?  @map("customer_name")
  phone        String?
  email        String?
  productId    String?  @map("product_id")
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  message      String
  source       String   @default("WEBSITE")
  status       String   @default("NEW")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("enquiries")
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
